model TaskCategory {
  id          String   @id @default(cuid())
  publicId    String   @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]
  recurrences TaskRecurrence[]

  @@map("task_category")
}

model Task {
  id               String             @id @default(cuid())
  publicId         String             @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  referenceCode    String             @unique
  title            String
  description      String?
  remarks          String?
  priority         TaskPriority       @default(MEDIUM)
  status           TaskStatus         @default(PENDING)
  scope            TaskScope          @default(TEAM)
  dueAt            DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  completionMode   TaskCompletionMode @default(REVIEW_REQUIRED)
  completionNote   String?
  allowSelfClaim   Boolean            @default(false)
  scheduledStartAt DateTime?
  recurrenceId     String?
  occurrenceKey    String?

  teamId      String?
  categoryId  String?
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team?         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  category  TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  assignments   TaskAssignment[]    @relation("TaskAssignments")
  statusHistory TaskStatusHistory[]
  submissions   TaskSubmission[]
  attachments   TaskAttachment[]
  recurrence    TaskRecurrence?     @relation(fields: [recurrenceId], references: [id], onDelete: Restrict)
  reminder      TaskReminder?
  distribution  TaskDistribution?

  @@unique([recurrenceId, occurrenceKey])
  @@index([teamId])
  @@index([scope])
  @@index([scope, status])
  @@index([status])
  @@index([priority])
  @@index([dueAt])
  @@index([createdById])
  @@index([categoryId])
  @@map("task")
}

model TaskAssignment {
  id                String    @id @default(cuid())
  taskId            String
  responsibleUserId String
  assignedById      String
  assignedAt        DateTime  @default(now())
  unassignedAt      DateTime?
  note              String?

  task            Task @relation("TaskAssignments", fields: [taskId], references: [id], onDelete: Cascade)
  responsibleUser User @relation("ResponsibleAssignments", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  assignedBy      User @relation("AssignmentsCreated", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([taskId, assignedAt])
  @@index([responsibleUserId])
  @@index([assignedById])
  @@map("task_assignment")
}

model TaskRecurrence {
  id                       String                       @id @default(cuid())
  publicId                 String                       @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  frequency                TaskRecurrenceFrequency
  scope                    TaskScope                    @default(TEAM)
  createdById              String
  defaultResponsibleUserId String
  teamId                   String?
  categoryId               String?
  title                    String
  description              String?
  remarks                  String?
  priority                 TaskPriority                 @default(MEDIUM)
  anchorDueAt              DateTime
  anchorLocalDay           Int?
  anchorLocalWeekday       Int?
  anchorLocalTime          String
  nextOccurrenceAt         DateTime
  reminderLeadMinutes      Int                          @default(1440)
  isActive                 Boolean                      @default(true)
  broadcastAll             Boolean                      @default(false)
  distributionLeadMinutes  Int?
  lastBlockedOccurrenceKey String?
  lastBlockedReason        TaskRecurrenceBlockedReason?
  lastBlockedNotifiedAt    DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  createdBy              User          @relation("TaskRecurrenceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  defaultResponsibleUser User          @relation("TaskRecurrenceResponsible", fields: [defaultResponsibleUserId], references: [id], onDelete: Restrict)
  team                   Team?         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  category               TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tasks                  Task[]

  @@index([isActive, nextOccurrenceAt])
  @@index([createdById])
  @@index([defaultResponsibleUserId])
  @@index([teamId])
  @@map("task_recurrence")
}

model TaskDistribution {
  id          String                 @id @default(cuid())
  taskId      String                 @unique
  scheduledAt DateTime
  status      TaskDistributionStatus @default(PENDING)
  sentAt      DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@map("task_distribution")
}

model TaskReminder {
  id          String             @id @default(cuid())
  taskId      String             @unique
  scheduledAt DateTime
  status      TaskReminderStatus @default(PENDING)
  sentAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@map("task_reminder")
}

model TaskStatusHistory {
  id          String      @id @default(cuid())
  taskId      String
  fromStatus  TaskStatus?
  toStatus    TaskStatus
  changedById String
  notes       String?
  changedAt   DateTime    @default(now())

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User @relation("TaskStatusChanges", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([taskId, changedAt])
  @@index([changedById])
  @@map("task_status_history")
}
