model Notification {
  id         String    @id @default(cuid())
  publicId   String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  receiverId String
  actorId    String?
  type       String
  title      String
  body       String
  targetType String?
  targetId   String?
  targetPublicId String? @map("target_public_id") @db.Uuid
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  receiver User  @relation("ReceivedNotifications", fields: [receiverId], references: [id], onDelete: Cascade)
  actor    User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([receiverId, readAt, createdAt])
  @@index([receiverId, createdAt])
  @@index([type, createdAt])
  @@index([targetType, targetId])
  @@index([targetType, targetPublicId])
  @@map("notification")
}
