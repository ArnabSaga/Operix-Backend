<p class="eyebrow eyebrow-warning">Security request</p>
<h1 class="heading">Reset your password</h1>
<p class="greeting">Hi <%= recipientName %>,</p>
<p class="subheading">
  We received a request to reset the password for your Operix account.
</p>

<table class="info-card warning-card" role="presentation" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td>
      <p class="info-card-title">Security action</p>
      <p class="info-card-copy">
        Use the secure button below to choose a new password.
      </p>
    </td>
  </tr>
</table>

<table class="cta-row" role="presentation" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td align="center">
      <a class="email-button" href="<%= resetUrl %>">Reset Password</a>
    </td>
  </tr>
</table>

<p class="expiry-text">This reset link expires in <%= expiryHours %> hours.</p>

<div class="link-fallback">
  <p class="link-fallback-label">If the button does not open, use this secure link:</p>
  <a class="link-fallback-url" href="<%= resetUrl %>"><%= resetUrl %></a>
</div>

<div class="divider"></div>

<table class="security-card" role="presentation" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td>
      <p class="info-card-title">Did not request this?</p>
      <p class="info-card-copy">
        You can safely ignore this email. Your current password remains unchanged until the reset process is completed.
      </p>
      <p class="notice-line">Do not forward this email.</p>
      <p class="notice-line">Operix will never ask you for your password.</p>
    </td>
  </tr>
</table>
