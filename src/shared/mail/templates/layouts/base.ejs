<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="supported-color-schemes" content="dark light" />
    <title><%= documentTitle %></title>
    <style>
      <%- css %>
    </style>
  </head>
  <body>
    <div class="preheader"><%= preheaderText %></div>
    <table class="email-page" role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td class="email-page-cell" align="center">
          <table class="email-shell" role="presentation" width="100%" cellpadding="0" cellspacing="0">
            <tr>
              <td class="email-header">
                <%- include("../partials/header.ejs") %>
              </td>
            </tr>
            <tr>
              <td>
                <table class="email-card" role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td class="email-content"><%- bodyHtml %></td>
                  </tr>
                  <tr>
                    <td class="email-footer"><%- include("../partials/footer.ejs") %></td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
