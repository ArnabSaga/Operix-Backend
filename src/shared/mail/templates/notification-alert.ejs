<p class="eyebrow eyebrow-info">Operix update</p>
<h1 class="heading"><%= heading %></h1>
<p class="greeting">Hi <%= recipientName %>,</p>
<p class="subheading"><%= message %></p>
<% if (details.length > 0) { %>
  <table class="details" role="presentation" cellpadding="0" cellspacing="0">
    <% details.forEach((detail) => { %>
      <tr>
        <td class="details-label"><%= detail.label %></td>
        <td class="details-value"><%= detail.value %></td>
      </tr>
    <% }); %>
  </table>
<% } %>
<% if (actionLabel && actionUrl) { %>
  <table class="cta-row" role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center">
        <a class="email-button" href="<%= actionUrl %>"><%= actionLabel %></a>
      </td>
    </tr>
  </table>
<% } %>

<div class="divider"></div>
<p class="quiet-note">
  You received this message because an Operix action requires your attention.
</p>
