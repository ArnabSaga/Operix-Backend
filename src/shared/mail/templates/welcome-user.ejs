<p class="eyebrow eyebrow-success">Account created</p>
<h1 class="heading">Welcome to Operix</h1>
<p class="greeting">Hi <%= recipientName %>,</p>
<p class="subheading">
  Your Operix account has been created and is ready for you.
</p>

<p class="section-title">Account details</p>
<table class="details" role="presentation" cellpadding="0" cellspacing="0">
  <tr>
    <td class="details-label">Email</td>
    <td class="details-value"><%= accountEmail %></td>
  </tr>
  <tr>
    <td class="details-label">Role</td>
    <td class="details-value"><span class="role-pill"><%= roleLabel %></span></td>
  </tr>
</table>
<p class="center-note">Use the credentials provided by your administrator to sign in.</p>

<table class="cta-row" role="presentation" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td align="center">
      <a class="email-button" href="<%= loginUrl %>">Sign In to Operix</a>
    </td>
  </tr>
</table>

<div class="divider"></div>
<p class="section-title">Getting started</p>
<table class="compact-steps" role="presentation" width="100%" cellpadding="0" cellspacing="0">
  <tr><td class="compact-step-number">01</td><td>Sign in to Operix</td></tr>
  <tr><td class="compact-step-number">02</td><td>Review your dashboard</td></tr>
  <tr><td class="compact-step-number">03</td><td>Check your assigned work</td></tr>
</table>
